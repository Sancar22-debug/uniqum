# ===========================
# UNIQUM Environment Variables
# ===========================
# Copy this file to .env.local and fill in the values
# These MUST also be set in the Cloudflare Worker:
# Workers & Pages → uniqum → Settings → Variables and Secrets

# AmoCRM Integration
AMOCRM_SUBDOMAIN=your_subdomain_here
AMOCRM_LONG_LIVED_TOKEN=your_long_lived_token_here

# The API route finds the matching pipeline/status automatically by this name.
AMOCRM_STATUS_NAME=Заявки с сайта (приоритет 1)

# Optional overrides. Use only IDs returned by GET /api/v4/leads/pipelines.
# Do not put the amoCRM account ID in AMOCRM_PIPELINE_ID.
# AMOCRM_PIPELINE_ID=your_pipeline_id
# AMOCRM_STATUS_ID=your_status_id
